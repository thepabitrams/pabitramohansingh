---
import BaseLayout from '../layouts/BaseLayout.astro';
import Bio from '../components/home/Bio.astro';
import Profile from '../components/home/Profile.astro';
import WhatIDo from '../components/home/WhatIDo.astro';
import Socials from '../components/home/Socials.astro';
---

<BaseLayout title="Pabitra Mohan Singh – MS Computer Science Student">
  <section class="py-16 md:py-24 max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col-reverse md:flex-row items-center gap-12 md:gap-16">
      <Bio />
      <Profile />
    </div>
    
    <div class="mt-12 flex justify-center md:justify-start animate-on-load animate-slide-left delay-3">
      <Socials />
    </div>
    
    <div class="mt-16">
      <WhatIDo />
    </div>
  </section>
</BaseLayout>