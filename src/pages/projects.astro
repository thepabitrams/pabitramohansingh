---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectWrapper from '../components/projects/ProjectWrapper.astro';
import ProjectGrid from '../components/projects/ProjectGrid.astro';
import ProjectAbout from '../components/projects/ProjectAbout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');

const entries = projects.map((entry) => ({
  slug: entry.id,
  data: entry.data,
  body: entry.body || '',
}));
---

<BaseLayout title="Projects – Pabitra Mohan Singh">
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-12 md:py-20 relative">
    <ProjectWrapper />
    <ProjectGrid entries={entries} />
    {entries.length === 0 && (
      <p class="text-center text-red-500 mt-10">⚠️ No projects found. Check your content folder.</p>
    )}

    <ProjectAbout entries={entries} />
  </section>
</BaseLayout>