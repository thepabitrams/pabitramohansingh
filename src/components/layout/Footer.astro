  <p>© 2026 Pabitra Mohan Singh</p>

  {!isHome && (
    <div class="flex justify-center gap-4 mt-2">
      <a href="https://github.com/thepabitrams" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition">GitHub</a>
      <a href="https://x.com/learnpabitrams" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition">Twitter</a>
      <a href="mailto:contactpabitrams@gmail.com" class="hover:text-primary transition">Contact Me</a>
    </div>
  )}
</footer>